# Financial DB integration test env example
# Use only against an isolated, disposable Supabase project or schema.

ORBI_RUN_DB_INTEGRATION=true
ORBI_DB_INTEGRATION_ALLOW_WRITES=false
# Required as true for write tests. The target must contain disposable fixtures only.
ORBI_DB_TEST_DISPOSABLE=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional test tuning
ORBI_DB_TEST_AMOUNT=0.01
ORBI_DB_TEST_INSUFFICIENT_AMOUNT=999999

# Write-enabled fixture ids
ORBI_DB_TEST_USER_ID=00000000-0000-0000-0000-000000000001
ORBI_DB_TEST_SOURCE_WALLET_ID=00000000-0000-0000-0000-000000000002
ORBI_DB_TEST_TARGET_WALLET_ID=00000000-0000-0000-0000-000000000003
ORBI_DB_TEST_INTERNAL_TRANSFER_VAULT_ID=00000000-0000-0000-0000-000000000004
ORBI_DB_TEST_LOW_BALANCE_WALLET_ID=00000000-0000-0000-0000-000000000005
ORBI_DB_TEST_LOCKED_WALLET_ID=00000000-0000-0000-0000-000000000006
ORBI_DB_TEST_REVIEW_ACTOR_ID=00000000-0000-0000-0000-000000000007
ORBI_DB_TEST_DRIFT_WALLET_ID=00000000-0000-0000-0000-000000000008
ORBI_DB_TEST_WEBHOOK_PARTNER_ID=00000000-0000-0000-0000-000000000009
ORBI_DB_TEST_OPERATING_VAULT_ID=00000000-0000-0000-0000-000000000010
ORBI_DB_TEST_ESCROW_VAULT_ID=00000000-0000-0000-0000-000000000011
ORBI_DB_TEST_BUDGET_CATEGORY_ID=00000000-0000-0000-0000-000000000012
ORBI_DB_TEST_BUDGET_TRIGGER_AMOUNT=1000
ORBI_DB_TEST_WITHDRAWAL_PROVIDER_ID=00000000-0000-0000-0000-000000000013

# Disposable treasury concurrency fixtures. Admins 1/2 and maker belong to the
# treasury organization; cross-org admin must belong to a different organization.
ORBI_DB_TEST_TREASURY_MAKER_ID=00000000-0000-0000-0000-000000000014
ORBI_DB_TEST_TREASURY_ADMIN_1_ID=00000000-0000-0000-0000-000000000015
ORBI_DB_TEST_TREASURY_ADMIN_2_ID=00000000-0000-0000-0000-000000000016
ORBI_DB_TEST_TREASURY_CROSS_ORG_ADMIN_ID=00000000-0000-0000-0000-000000000017
ORBI_DB_TEST_TREASURY_ORG_ID=00000000-0000-0000-0000-000000000018
ORBI_DB_TEST_TREASURY_GOAL_ID=00000000-0000-0000-0000-000000000019
ORBI_DB_TEST_TREASURY_DESTINATION_WALLET_ID=00000000-0000-0000-0000-000000000020
